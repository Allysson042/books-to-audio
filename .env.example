GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# TTS premium (~$0,06 por áudio de ~3000 chars; OFF por default na sidebar = Edge grátis)
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2.1
# Sobrescreve a voz das personas p/ testes (ex. voz do Gemini TTS: Kore, Umbriel, Puck)
# OPENROUTER_TTS_VOICE=Kore
LLM_PRIMARY=gemini
OFFLINE_MODE=false
# --- Knobs P0 (docs/LIMITS.md §10) — descomente p/ sobrescrever; defaults idênticos ---
# (comentário sempre em linha própria: `python-dotenv` não descarta comentário inline)
# CHUNK_CHARS=4500
# MAX_TOKENS=2500
# CONTEXT_TOKENS_BUDGET=24000
# MAX_QUERY_CHARS=2000
# RETRIEVAL_PREFETCH=20
# RETRIEVAL_TOP_N=5
# MAX_NODES=6
# MAX_CHUNKS=10
# TTS_MAX_CHARS=15000
# TTS_SLICE_CHARS=2500
# LLM_TIMEOUT=120
# LLM_RETRIES=1
# LLM_PROMPT_CHARS=12000
# LLM_TEMPERATURE=
# TREE_DELIVERY=ranked
# TREE_CHUNKS_PATH=storage/tree_chunks.jsonl
# TREE_PROMPT=v2
# (CHUNK_CHARS=corte por chunk no Pass1 · MAX_TOKENS=saída do LLM · CONTEXT_TOKENS_BUDGET=orçamento total, 0 desliga)
# (RETRIEVAL_PREFETCH=top-k denso/BM25 · RETRIEVAL_TOP_N=chunks finais do vetorial · MAX_NODES/MAX_CHUNKS=vectorless)
# (TTS_MAX_CHARS=trava de custo do premium · TTS_SLICE_CHARS=fatia por request · MAX_QUERY_CHARS=input da UI)
# (LLM_TIMEOUT/LLM_RETRIES=timeout e tentativas extras · LLM_PROMPT_CHARS=fallback opencode)
# (TREE_DELIVERY=ranked (in_scope+quota) ou legacy (ordem de arquivo) · LLM_TEMPERATURE vazio = default do modelo)
# (TREE_PROMPT=v2 (páginas impressas + snippet por folha) ou v1 (prompt antigo, reusa cache tree_sel antigo))
